APP_ENV=dev # Opciones: dev | prod
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

DB_DRIVER=postgres # Opciones: mysql | postgres
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Calibración del Pool de Conexiones (Opcional, tiene valores seguros por defecto)
# DB_MAX_OPEN_CONNS=25      # Límite máximo de conexiones concurrentes abiertas
# DB_MAX_IDLE_CONNS=10      # Conexiones en reposo listas para responder al instante
# DB_CONN_MAX_LIFETIME=15   # Tiempo de vida máximo de una conexión en minutos